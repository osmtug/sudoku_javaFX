<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<VBox fx:id="vBoxMain" xmlns:fx="http://javafx.com/fxml" fx:controller="sudokuosman.view.SudokuController" spacing="10" alignment="TOP_LEFT" >
    <Button fx:id="btnRetour" text="←" prefWidth="35" alignment="center"/>
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <VBox alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
        <GridPane fx:id="gridPane" hgap="1" vgap="1" alignment="center"/>
        <HBox fx:id="numberButtons" spacing="5" alignment="center">
            <Label fx:id="normalLabel" text="Normal"/>

            <StackPane fx:id="switchContainer" prefWidth="50" prefHeight="10"
                       style="-fx-background-color: lightgray; -fx-background-radius: 30;">
                <!-- fond de l'interrupteur -->
                <Rectangle fx:id="track" width="50" height="10" arcWidth="10" arcHeight="10"
                           fill="lightgray"/>
                <!-- curseur -->
                <Circle fx:id="thumb" radius="13" fill="white" stroke="gray" translateX="-10"/>
            </StackPane>

            <Label fx:id="annotationLabel" text="Annotation"/>
        </HBox>
    </VBox>

</VBox>
